# ---- Django ----
DJANGO_SECRET_KEY=请替换为随机生成的密钥
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 生产环境开启 HTTPS 时再设置
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
# DJANGO_SECURE_SSL_REDIRECT=1

# ---- AI 服务 ----
# provider: ollama（本地）/ openai（任意 OpenAI 兼容服务）/ mock（离线演示）
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:7b
# 可选模型列表，格式 模型ID|显示名
AI_MODELS=qwen2.5:7b|通义千问 2.5 · 本地,deepseek-r1:8b|DeepSeek R1 · 本地,llama3.1:8b|Llama 3.1 · 本地
AI_TIMEOUT=120
AI_MAX_TOKENS=1800
AI_TEMPERATURE=0.6

# 使用云端 OpenAI 兼容服务时的示例：
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-xxxx
# AI_MODEL=deepseek-chat
# AI_MODELS=deepseek-chat|DeepSeek V3,deepseek-reasoner|DeepSeek R1
