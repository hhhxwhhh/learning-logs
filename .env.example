# ---- Django ----
DJANGO_SECRET_KEY=请替换为随机生成的密钥
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 生产环境开启 HTTPS 时再设置
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
# DJANGO_SECURE_SSL_REDIRECT=1

# ---- 数据库 ----
# 默认 sqlite；改成 postgres 需要装 psycopg2-binary
DJANGO_DB_ENGINE=sqlite
DJANGO_DB_PATH=db.sqlite3
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=zhiji
# POSTGRES_USER=zhiji
# POSTGRES_PASSWORD=请设置

# ---- AI 服务 ----
# provider: ollama（本地）/ openai（任意 OpenAI 兼容服务）/ mock（离线演示）
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:7b
# 可选模型列表，格式 模型ID|显示名
AI_MODELS=qwen2.5:7b|通义千问 2.5 · 本地,deepseek-r1:8b|DeepSeek R1 · 本地,llama3.1:8b|Llama 3.1 · 本地
AI_TIMEOUT=120
AI_MAX_TOKENS=1800
AI_TEMPERATURE=0.6

# 使用云端 OpenAI 兼容服务时的示例：
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=sk-xxxx
# AI_MODEL=deepseek-chat
# AI_MODELS=deepseek-chat|DeepSeek V3,deepseek-reasoner|DeepSeek R1

# ---- Redis（缓存 / 任务队列 / 实时通道）----
# 留空则退回进程内缓存 + 同步任务 + 单进程通道层，开发环境可完全不配
REDIS_URL=redis://127.0.0.1:6379/0
# 缓存键前缀与默认过期秒数
CACHE_KEY_PREFIX=zhiji
CACHE_TTL=300

# ---- Celery（异步任务）----
# 默认复用 REDIS_URL；单独指定可以指向另一套实例
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# 没有 broker 时把任务改成同步执行
CELERY_TASK_ALWAYS_EAGER=0

# ---- Kafka（学习事件总线）----
# 填上 broker 地址即启用；留空则事件落到 Redis Stream
KAFKA_ENABLED=0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=zhiji.learning.events
KAFKA_CONSUMER_GROUP=zhiji-consumer
KAFKA_CLIENT_ID=zhiji-web
KAFKA_PRODUCER_TIMEOUT=3

# ---- 日志 ----
# text：普通文本行；json：结构化 JSON 行，便于日志采集
DJANGO_LOG_FORMAT=text
DJANGO_LOG_LEVEL=INFO
DJANGO_REQUEST_LOG_LEVEL=INFO

# ---- 事件与活动流 ----
EVENT_LOG_RETENTION_DAYS=30
ACTIVITY_FEED_SIZE=60
